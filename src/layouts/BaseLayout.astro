---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Index of public GitHub Pages sites, modules, and tools across my accounts.',
} = Astro.props;
const pageTitle = title === 'Index' ? 'pages.johna.kiwi' : `${title} · pages.johna.kiwi`;
const home = withBase();
const categoriesHref = withBase('categories/');
const shortcutLabel = 'Ctrl K';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const rssHref = withBase('rss.xml');
const ogImageURL = new URL(withBase('og.png'), Astro.site);
const pathNorm = Astro.url.pathname.replace(/\/+$/, '') || '/';
const homeNorm = home.replace(/\/+$/, '') || '/';
const isHome = pathNorm === homeNorm;
const isCategories = pathNorm.includes('/categories');
const gaId = 'G-6GP64SX615';
const enableAnalytics = import.meta.env.PROD && Boolean(gaId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eef4f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#071014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="pages.johna.kiwi" href={rssHref} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="pages.johna.kiwi" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content="pages.johna.kiwi - project index" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="pages.johna.kiwi - project index" />

    <title>{pageTitle}</title>
    {
      enableAnalytics && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
    <script is:inline>
      (function () {
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {
          t = null;
        }
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=optional"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <svg class="sprite" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="i-auto" viewBox="0 0 24 24">
          <path
            d="M12 2v2M14.837 16.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715M16 12a4 4 0 0 0-4-4M19 5l-1.256 1.256M20 12h2"
          ></path>
        </symbol>
        <symbol id="i-light" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </symbol>
        <symbol id="i-dark" viewBox="0 0 24 24">
          <path
            d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
          ></path>
        </symbol>
      </defs>
    </svg>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={home}>pages.johna.kiwi</a>
        <div class="site-header__actions">
          <form class="site-search" id="site-search" action={home} method="get" role="search" data-home={home}>
            <label class="visually-hidden" for="site-search-input">Search index</label>
            <svg class="site-search__icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M10.5 3a7.5 7.5 0 0 1 5.95 12.06l4.25 4.24a1 1 0 0 1-1.42 1.42l-4.24-4.25A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11a5.5 5.5 0 0 0 0-11Z"
              />
            </svg>
            <input
              id="site-search-input"
              name="q"
              type="search"
              placeholder="Search"
              autocomplete="off"
              enterkeyhint="search"
            />
            <kbd class="site-search__kbd" data-shortcut>{shortcutLabel}</kbd>
          </form>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <nav class="site-nav" aria-label="Primary">
      <div class="site-nav__inner">
        <a href={home} aria-current={isHome && !isCategories ? 'page' : undefined}>Index</a>
        <a href={categoriesHref} aria-current={isCategories ? 'page' : undefined}>Categories</a>
        <a href="https://johna.kiwi/" rel="noopener noreferrer">johna.kiwi</a>
      </div>
    </nav>

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          <span class="brand-name">pages.johna.kiwi</span>
          · John Ajera ·
          <a href="https://johna.kiwi/" rel="noopener noreferrer">johna.kiwi</a>
          ·
          <a href="https://guides.johna.kiwi/" rel="noopener noreferrer">guides</a>
          ·
          <a href="https://github.com/jajera/pages-index">GitHub</a>
          ·
          <a href={rssHref}>RSS</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const form = document.getElementById('site-search');
        const input = document.getElementById('site-search-input');
        const shortcut = document.querySelector('[data-shortcut]');
        if (!form || !input) return;

        const home = form.dataset.home || '/';
        const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.platform || navigator.userAgent);
        if (shortcut) shortcut.textContent = isMac ? '⌘ K' : 'Ctrl K';

        const params = new URLSearchParams(window.location.search);
        const initialQuery = params.get('q') || '';
        if (initialQuery) input.value = initialQuery;

        document.addEventListener('keydown', (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            input.focus();
            input.select();
          }
        });

        form.addEventListener('submit', (event) => {
          if (document.getElementById('entry-list')) {
            event.preventDefault();
            input.dispatchEvent(new Event('input', { bubbles: true }));
            return;
          }
          const query = input.value.trim();
          if (!query) {
            event.preventDefault();
            window.location.href = home;
          }
        });
      })();
    </script>
  </body>
</html>
