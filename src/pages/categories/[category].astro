---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RepoCard from '../../components/RepoCard.astro';
import { CATEGORY_KEYS, CATEGORY_LABELS, loadRepositories } from '../../lib/repositories';

export function getStaticPaths() {
  return CATEGORY_KEYS.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params as { category: string };
const label = CATEGORY_LABELS[category] || category;
const repos = loadRepositories()
  .repositories.filter((repo) => repo.category === category)
  .sort((a, b) => {
    const au = a.updated_at || a.created_at || '';
    const bu = b.updated_at || b.created_at || '';
    return bu.localeCompare(au);
  });
---

<BaseLayout title={label} description={`Repositories in the ${label} category.`}>
  <h1 class="page-title">{label}</h1>
  <p class="page-lede">Entries in this category.</p>

  {
    repos.length === 0 ? (
      <p class="empty-state">No entries in this category yet.</p>
    ) : (
      <ul class="entry-list">
        {repos.map((repo) => (
          <RepoCard repo={repo} />
        ))}
      </ul>
    )
  }
</BaseLayout>
