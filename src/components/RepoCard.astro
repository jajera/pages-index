---
import type { RepoItem } from '../lib/repositories';
import { CATEGORY_LABELS, primaryUrl } from '../lib/repositories';

interface Props {
  repo: RepoItem;
}

const { repo } = Astro.props;
const href = primaryUrl(repo);
const categoryLabel = CATEGORY_LABELS[repo.category] || repo.category;
const searchBlob = [
  repo.name,
  repo.full_name,
  repo.description || '',
  repo.owner?.login || '',
  categoryLabel,
  ...(repo.topics || []),
]
  .join(' ')
  .toLowerCase();
---

<li data-category={repo.category} data-search={searchBlob}>
  <a class="entry-card" href={href} rel="noopener noreferrer">
    <div class="entry-meta">
      <span class="badge badge--walkthrough">{categoryLabel}</span>
      <span class="badge badge--category">{repo.owner?.login || 'unknown'}</span>
    </div>
    <h2 class="entry-card__title">{repo.name}</h2>
    {repo.description && <p class="entry-card__summary">{repo.description}</p>}
  </a>
</li>
